# ════════════════════════════════════════════════════════════════════════════
#  SPECTRAVEIN Backend - SUPABASE DIRECT CONNECTION
# ════════════════════════════════════════════════════════════════════════════
#
# This is an ALTERNATIVE connection configuration that bypasses the Connection
# Pooling endpoint. Use this if Connection Pooling (port 6543) has authentication
# issues.
#
# Reference Format:
#   Pooling:  postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
#   Direct:   postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-ap-southeast-1.db.supabase.com:5432/postgres?sslmode=require
#

# ── CORS Configuration ───────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000

# ── Database Configuration: DIRECT CONNECTION (NOT Pooling) ─────────────────
# This skips the pgBouncer pooler and connects directly to PostgreSQL.
# Use this if the standard DATABASE_URL (pooling endpoint) has auth issues.
#
# 1. Log into Supabase Console
# 2. Go to: Database → Connection String (select "Direct" tab, NOT "Connection Pooling")
# 3. Copy the PostgreSQL URI
# 4. Paste it below
#
SUPABASE_DATABASE_URL_DIRECT=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-1-ap-southeast-1.db.supabase.com:5432/postgres?sslmode=require

# ── Application Metadata ─────────────────────────────────────────────────────
APP_NAME=SPECTRAVEIN Mining Intelligence API
APP_VERSION=2.0.0
ENVIRONMENT=development

# ── Logging Configuration ────────────────────────────────────────────────────
LOG_LEVEL=DEBUG

# ── Data Source ──────────────────────────────────────────────────────────────
CSV_PATH=asteroid_labeled.csv
